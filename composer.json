{
  "name": "x-orion-mg/my-ai-agent",
  "description": "WordPress AI Agent plugin for content and WooCommerce generation",
  "type": "wordpress-plugin",
  "require": {
    "php": "^8.2",
    "x-orion-mg/my-ai-lib": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/x-orion-mg/my-ia-lib-2.git"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "MyAIAgent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MyAIAgent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
